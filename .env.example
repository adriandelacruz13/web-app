# Veloce Growth - Environment Configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.

# Port the production Express server binds (default 3000)
PORT=3000

# HubSpot private app access token - stored STRICTLY server-side.
# The client bundle never sees this value.
HUBSPOT_API_KEY=replace_with_hubspot_private_app_token

# Comma-separated allowlist for cross-origin requests.
# Leave empty for same-origin-only (the default architecture).
# CORS_ORIGIN=https://app.example.com

# Marketing SDK identifiers (public identifiers, not secrets)
# Injected into the client at build time via the VITE_ prefix.
VITE_GTM_ID=GTM-XXXXXXX
VITE_META_PIXEL_ID=1098472918234891

# Fallback canonical origin used for robots/sitemap generation
DEFAULT_URL=https://velocegrowth.com/